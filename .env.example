# ==============================================================================
# CivicPulse — Backend & Database Configuration Environment Template
# ==============================================================================

# Application Configuration
APP_NAME=CivicPulse API
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api
PORT=8000
HOST=0.0.0.0

# CORS Configuration (JSON-encoded array or comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# PostgreSQL & PostGIS Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=civicpulse_db

# SQLAlchemy Database Connection URL (using psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/civicpulse_db

# Media & Storage Paths
EVIDENCE_DIR=outputs/evidence
PREDICTIONS_DIR=outputs/predictions

ROBOFLOW_API_KEY=your_roboflow_api_key_here