# CivicPulse Dashboard — Frontend Environment Example Configuration
# Copy this file to .env or populate variables during production build

# Production FastAPI Backend Base URL (Replace <PUBLIC_API_HOST> with Cloudflare Tunnel domain or public URL)
VITE_API_BASE_URL=https://<PUBLIC_API_HOST>/api/v1

# Optional: Google Maps API Key for production Map view (Restricted to deployed HTTP referrer in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=
